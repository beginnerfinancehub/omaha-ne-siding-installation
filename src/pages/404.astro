---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site.js';
---
<BaseLayout
  title="Page not found"
  description="Page not found."
>
  <div class="hero">
    <div class="wrap">
      <div>
        <h1>Page not found</h1>
        <p class="lede">That page does not exist. Here is the way back, or just call.</p>
        <a class="btn btn-call" href={SITE.phoneHref}>Call {SITE.phoneDisplay}<small>{SITE.hours}</small></a>
        <a class="btn btn-quiet" href="/">Back to home</a>
      </div>
    </div>
  </div>
</BaseLayout>
