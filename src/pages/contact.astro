---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site.js';
---
<BaseLayout
  title="Contact"
  description="Get in touch about siding installation, repair, or storm damage in the Omaha, NE metro: call directly or send your property details through this form."
>
  <div class="hero">
    <img class="hero-bg" src="/images/omaha-home-front-entry-siding.jpg" alt="The front entry of a Midwest home with vinyl siding visible on the facade" width="1600" height="900" loading="eager" fetchpriority="high" />
    <div class="wrap">
      <div>
        <h1>Get in touch</h1>
        <p class="lede">Phone is quickest. If you'd rather write it out, the form below reaches the same inbox, and you'll hear back the same day.</p>
        <a class="btn btn-call" href={SITE.phoneHref}>Call {SITE.phoneDisplay}<small>{SITE.hours}</small></a>
      </div>
    </div>
  </div>

  <section>
    <div class="wrap">
      <p class="eyebrow">Send your details</p>
      <h2>Tell us about the project</h2>
      <p class="lead-out">The useful basics: roughly how much of the home needs siding, whether it's storm damage, a repair, or a full replacement, and the current material if you know it. A city or zip narrows down whether you're inside the coverage area.</p>

      <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" enctype="multipart/form-data" action="/contact/thank-you/">
        <input type="hidden" name="form-name" value="contact" />
        <p class="hp-field">
          <label>Don't fill this out if you're human: <input name="bot-field" /></label>
        </p>
        <div class="field-row">
          <div class="field">
            <label for="first-name">First name</label>
            <input type="text" id="first-name" name="first_name" required />
          </div>
          <div class="field">
            <label for="last-name">Last name</label>
            <input type="text" id="last-name" name="last_name" required />
          </div>
        </div>
        <div class="field">
          <label for="phone">Phone or email</label>
          <input type="text" id="phone" name="phone" required />
        </div>
        <div class="field">
          <label for="location">City or zip</label>
          <input type="text" id="location" name="location" placeholder="e.g. Omaha, 68106" />
        </div>
        <div class="field">
          <label for="message">Tell us about the project</label>
          <textarea id="message" name="message" required placeholder="New install, repair, or storm damage, roughly how much of the home, and the current material if you know it."></textarea>
        </div>
        <div class="field">
          <label for="photo">Photo of the siding (optional)</label>
          <input type="file" id="photo" name="photo" accept="image/*" multiple />
        </div>
        <button class="btn btn-call" type="submit">Get my free quote</button>
      </form>
    </div>
  </section>

  <section class="sunk">
    <div class="wrap">
      <p class="eyebrow">Your details</p>
      <div class="plain">
        <p>What you send goes straight to us, and we use it to follow up about your project and to connect you with the local siding contractor who does the work. We don't sell it to third-party lead brokers or use it for unrelated marketing. Full details on our <a href="/privacy/">Privacy &amp; Terms</a> page.</p>
      </div>
    </div>
  </section>
</BaseLayout>
