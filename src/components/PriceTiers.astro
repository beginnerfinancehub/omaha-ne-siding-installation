---
// Optional, opt-in shared component. Added 2026-08-15 (Chair decision,
// competitor design-teardown review). Generalizes the multi-material
// starting-price table found on Ideal Siding's site
// (08_Builds/design/competitor-patterns/siding-installation.md) into a
// reusable pattern for any LocalSiteLeads trade whose pricing splits into
// several named options, rather than the single size/tier scale
// CostCaller.astro answers. Activated here (2026-08-28, siding install #3):
// the 5 siding materials each carry a distinct disclosed price band, and
// Carp's Complete Exteriors' own competing calculator is confirmed broken
// (returns negative dollar figures), so a static, honest table beats a
// flashy one that fails. Structural CSS: template.css, "OPTIONAL:
// PRICE-TIER TABLE".
//
// Every figure passed in must be a real, sourced estimate, disclosed as an
// estimate, per 05_Content/quality-bar.md Part 1 Tier 1. This component
// never invents a number; it only displays what it is given.
interface Tier {
  name: string;
  price: string;
  unit: string;
  desc?: string;
}
interface Props {
  heading?: string;
  note: string;
  tiers: Tier[];
}
const { heading = 'What it costs', note, tiers } = Astro.props;
---
<div class="price-table">
  <h2>{heading}</h2>
  <p class="price-note">{note}</p>
  <ul class="price-tiers">
    {tiers.map((t) => (
      <li class="price-tier">
        <span class="tier-name">{t.name}</span>
        <span class="tier-figure">${t.price}<span> / {t.unit}, starting</span></span>
        {t.desc && <span class="tier-desc">{t.desc}</span>}
      </li>
    ))}
  </ul>
</div>
